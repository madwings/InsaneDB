{
	"name" : "madwings/insanedb",
	"version": "1.4.1",
	"description" : "InsaneDB is a Database Toolkit for PHP forked from CodeIgniter 3",
	"type": "project",
	"homepage": "https://github.com/madwings/InsaneDB",
	"license": "MIT",
	"support": {
		"wiki": "https://github.com/madwings/InsaneDB/wiki",
		"source": "https://github.com/madwings/InsaneDB"
	},
	"require": {
		"php": ">=8.0"
	},
	"scripts": {
		"test:coverage": [
			"@putenv XDEBUG_MODE=coverage",
			"phpunit --color=always --coverage-text --configuration tests/travis/sqlite.phpunit.xml"
		],
		"post-install-cmd": [
			"@php tests/patch-vendor.php"
		],
		"post-update-cmd": [
			"@php tests/patch-vendor.php"
		]
	},
	"require-dev": {
		"mikey179/vfsstream": "1.6.*",
		"phpunit/phpunit": "4.* || 5.* || 8.* || 9.*"
	}
}
